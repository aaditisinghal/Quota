# Copy to .env (git-ignored) and fill in. Environment variables override this file.
# Stripe sandbox secret key for `--stripe` (use a sandbox key, sk_test_..., never a live key).
STRIPE_API_KEY=
# Anthropic credentials for `--live` (or log in with `ant auth login`).
ANTHROPIC_API_KEY=
# Optional: model for --live (default claude-opus-5-5).
QUOTA_MODEL=
