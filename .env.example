# Copy to .env (git-ignored) and fill in. Environment variables override this file.
# Stripe sandbox secret key for `--stripe` (use a sandbox key, sk_test_..., never a live key).
STRIPE_API_KEY=
# Anthropic credentials for `--live` (or log in with `ant auth login`).
ANTHROPIC_API_KEY=
# Optional: model for --live (default claude-opus-5-5).
QUOTA_MODEL=
# Elastic evidence layer (ELASTIC_TASKS). Create the key in Kibana: Connection details -> Create API key.
ELASTICSEARCH_URL=https://<project>.es.<region>.gcp.elastic.cloud:443
ELASTIC_API_KEY=
# Optional: defaults to ELASTICSEARCH_URL with ".es." swapped for ".kb.".
KIBANA_URL=
# Optional: live Elastic tests (pytest) run only with QUOTA_ELASTIC_LIVE=1.
QUOTA_ELASTIC_LIVE=
